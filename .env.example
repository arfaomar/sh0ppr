# Take the content of this file, put it in a .env.local file, and add the necessary values as per your PostgreSQL database configuration.

# Database Configuration
DB_HOSTNAME=
DB_PORT=5432 #recommended port for Postgres
DB_NAME=
DB_USER=
DB_PASSWORD=

# Database URL (Postgres) - No Modifications needed
DATABASE_URL=postgresql://$DB_USER:$DB_PASSWORD@$DB_HOSTNAME:$DB_PORT/$DB_NAME

# Pixabay API Key - Get it from https://pixabay.com/api/docs/
PIXABAY_API_KEY=